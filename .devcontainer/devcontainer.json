// Dev Container の設定。VS Code はこれを読んで「どのコンテナに、どんな状態で接続するか」を決める。
// 拡張子は .json だが、Dev Container 仕様ではコメントを書ける（JSONC）。
// → docs/notes/step-02-devcontainer.md
{
  "name": "todo-fastapi",

  // 独自 Dockerfile を直接指さず compose 経由にすることで、
  // 後で追加する db や api と同じネットワーク上に並べられる。
  "dockerComposeFile": ["../compose.yaml", "../compose.override.yaml"],
  "service": "devtools",

  // compose.override.yaml の bind mount 先と一致させる必要がある。
  "workspaceFolder": "/workspaces/todo-fastapi",

  "remoteUser": "vscode",

  // Claude Code をコンテナ内にインストールする（CLI と VS Code 拡張の両方）。
  // タグの :1.0 は Feature のインストールスクリプトのバージョンで、Claude Code 本体ではない。
  //
  // node は Claude Code が npm 経由で入るため必須。claude-code Feature は Node が無ければ
  // 自前で入れようとするが、Debian 系では nodejs と npm がパッケージとして分かれており
  // npm が入らずに失敗する。そのため Node は Feature として明示的に指定する。
  // 将来フロントエンドを足すときも、この Node をそのまま使う。
  //
  // いずれも開発ツールボックス側の話なので、本番イメージには一切影響しない。
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // ホストのユーザー UID に合わせてコンテナ内 vscode の UID を書き換える。
  // bind mount したファイルの所有者ズレ（git の dubious ownership）を防ぐ根本対策。
  "updateRemoteUserUID": true,

  // コンテナ作成直後に一度だけ走る。3つやっている。
  //
  // 1. safe.directory: updateRemoteUserUID でも所有者判定が食い違う環境があるための保険
  //    （CVE-2022-24765 の所有者チェック）。書き換わるのはコンテナ内の設定のみで、
  //    ホストの ~/.gitconfig には影響しない。
  // 2. uv sync: backend/uv.lock から devtools 側にも同じ venv を作る。api コンテナの
  //    /opt/venv は devtools から見えないため、Pylance に読ませる実体がここに要る。
  //    --frozen はロックファイルを再解決せずそのまま使う指定。
  //    → .vscode/settings.json の python.defaultInterpreterPath
  // 3. pre-commit install: .git/hooks/pre-commit を書き込み、git commit 時に
  //    .pre-commit-config.yaml の検査が走るようにする。
  //    → docs/notes/topic-lint-and-precommit.md
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && uv sync --frozen --project backend && pre-commit install",

  "customizations": {
    "vscode": {
      // 開発環境の定義をリポジトリに残すため、拡張機能もここで指定する。
      // ここに書いたものは Dev Container 接続時に自動インストールされる。
      // .vscode/extensions.json にも同じ一覧があるが、あちらは Dev Container を
      // 使わずにフォルダを開いた人への「推奨」表示で、役割が違う。
      // エディタ側の設定（フォーマッタ等）は .vscode/settings.json にある。
      // → docs/notes/step-10-lint-format-editor.md
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "oderwat.indent-rainbow",
        "mikestead.dotenv"
      ]
    }
  }
}
