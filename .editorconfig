# https://editorconfig.org
# エディタや言語を問わず、文字コード・改行コード・インデントを統一するための設定。
# 多くのエディタが標準またはプラグインで対応しており、
# フォーマッタ（ruff 等）が扱わないファイルにも効くのが利点。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,jsonc}]
indent_size = 2

# JS / TS 界隈の慣習は2。Prettier は自前の設定ファイルが無いとここを読むため、
# 4 のままだと create-next-app の生成物が全部インデントし直されてしまう。
[*.{js,jsx,mjs,cjs,ts,tsx,css}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown は行末の半角スペース2つが改行を意味するため、除去しない
trim_trailing_whitespace = false

# Makefile はタブでないと構文エラーになる
[Makefile]
indent_style = tab

# Caddy の整形コマンド（caddy fmt）はタブでインデントする。
# スペースのままだと、起動時に「整形されていない」と警告が出る。
[Caddyfile]
indent_style = tab
